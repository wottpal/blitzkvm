<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>xyz.scio.blitzkvm</string>
	<key>CFBundleName</key>
	<string>BlitzKVM</string>
	<key>CFBundleDisplayName</key>
	<string>BlitzKVM</string>
	<key>CFBundleExecutable</key>
	<string>BlitzKVM</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- JetKVMs answer plain http on the LAN, .local and VPN names; the
		     engine pins identity and certificates itself. (No
		     NSAllowsLocalNetworking: its presence makes macOS ignore
		     NSAllowsArbitraryLoads.) -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>BlitzKVM connects to your JetKVM devices on the local network.</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
</dict>
</plist>
