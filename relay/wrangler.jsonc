{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blitzkvm-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  // Invocation logs would keep request URLs (broker and approver ids) and metadata.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
  // Secrets: APNS_KEY (the .p8 file's contents), APNS_KEY_ID, APNS_TEAM_ID,
  // optionally APNS_TOPIC. See README.md.
}
