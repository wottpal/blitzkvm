+		MaxFPS:         int(p.GetMaxFps()),
+		BitrateKbps:    int(p.GetBitrateKbps()),
+		MaxBitrateKbps: int(p.GetMaxBitrateKbps()),
+		StillQP:        int(p.GetStillQp()),
+	}
+}
